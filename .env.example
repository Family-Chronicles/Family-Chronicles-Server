# Copy to .env and adjust. All values are optional unless noted.

# --- Server ---
PORT=8080
# Comma separated list of allowed origins for the web app, "*" allows all
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# --- Auth ---
# REQUIRED in production: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
TOKEN_LIFETIME=12h
# Initial admin, only created when there is no user yet.
# Without ADMIN_PASSWORD a random password is generated and printed once.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@family-chronicles.local
ADMIN_PASSWORD=

# --- Database ---
# "mongo" or "memory" (data is lost on restart, for trying things out)
DB_DRIVER=mongo
DB_HOST=mongodb://mongo:27017
DB_NAME=family-chronicles
DB_USER=admin
DB_PASSWORD=admin
