# Server
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=family-chronicles
MONGO_USERNAME=
MONGO_PASSWORD=

# Password transport RSA keys
# Use either the plain PEM values below or the *_BASE64 variants.
PASSWORD_PRIVATE_KEY=
PASSWORD_PUBLIC_KEY=
PASSWORD_PRIVATE_KEY_BASE64=
PASSWORD_PUBLIC_KEY_BASE64=
