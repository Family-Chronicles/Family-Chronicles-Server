# Copy to .env and adjust. All values are optional unless noted.

# --- Server ---
PORT=8080
# Comma separated list of origins allowed to call the API from another origin.
# Leave empty when the web app is served from the same origin (dev proxy / nginx).
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=300
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# "mongo": share live updates between several server instances using the same MongoDB
LIVE_RELAY=none

# --- Auth ---
# REQUIRED in production: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
TOKEN_LIFETIME=12h
# Initial admin, only created when there is no user yet.
# REQUIRED on the first start: ADMIN_PASSWORD (at least 8 characters).
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@family-chronicles.local
ADMIN_PASSWORD=

# --- Database ---
# "mongo" or "memory" (data is lost on restart, for trying things out)
DB_DRIVER=mongo
DB_HOST=mongodb://mongo:27017
DB_NAME=family-chronicles
DB_USER=admin
DB_PASSWORD=admin
